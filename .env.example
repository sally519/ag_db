RAG_DB_ENV=dev
RAG_DB_DATA_DIR=./data
RAG_DB_LOG_LEVEL=INFO
RAG_DB_CHROMA_DIR=./data/chroma
RAG_DB_DEFAULT_COLLECTION=documents
RAG_DB_CHUNK_SIZE=1000
RAG_DB_CHUNK_OVERLAP=200
RAG_DB_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_DB_EMBEDDING_DEVICE=auto
RAG_DB_EMBEDDING_MAX_LENGTH=2048
RAG_DB_EMBEDDING_BATCH_SIZE=16
